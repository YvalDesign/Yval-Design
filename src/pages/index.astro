---
import Layout from "../layouts/main.astro";
import { Image } from "astro:assets";
import space from "../assets/heroimage.png";
import Stratarea from "../components/strategy-area.astro";
import Webarea from "../components/Web-area.astro";
import Smarea from "../components/SM-area.astro";
import Filmarea from "../components/film-area.astro";
import Anfrage from "../components/Anfrage.astro";
---

<Layout
  title="Markenstrategie Agentur Hildesheim | Yval Design"
  description="yval ist eine Markenstrategie-Agentur aus Hildesheim. Wir helfen Unternehmen, die richtige Entscheidung zu treffen – bevor Geld in die falschen Maßnahmen fließt."
  canonicalPath="/"
>
  <div class="hero">
    <h1>
      WIR BRINGEN EUCH <br />
      <span class="tothe">ZUM <span class="moon">MOND</span></span>
    </h1>

    <Image
      class="heroimg"
      src={space}
      alt="Zwei junge Männer auf dem Mond"
      format="avif"
      quality={80}
      width={1600}
      loading="eager"
      fetchpriority="high"
    />
    <div class="gradient"></div>
  </div>

  <section class="headline fade-in">
    <div class="greet">MOIN!</div>

    <p class="greet-sub">
      Wir sind eure Markenstrategie- und <br />Designagentur in <span
        class="prim">Hildesheim</span
      >!

      <p class="greet-sub">
        Im kostenlosen Analysegespräch klären wir, wo ihr steht und ob ihr
        direkt umsetzen könnt oder erst einen Schritt zurückgehen solltet.
      </p>
    </p>
  </section>

  <h2 class="webheadline from-bottom">
    KOSTENLOSES <br />
    <span class="h2-span">Analyse Gespräch</span>
  </h2>

  <p class="greet-sub from-bottom delay-2">
    In einem kostenlosen Analysegespräch klären wir, wo ihr gerade steht und ob
    die Grundlage für Umsetzung bereits da ist.
  </p>
  <a class="btn from-bottom delay-3" href="/#Anfrage">
    <button>KOSTENLOSES GESPRÄCH!</button>
  </a>

  <div class="from-left"><Stratarea /></div>

  <div class="from-right"><Webarea /></div>

  <div class="from-left"><Smarea /></div>

  <div class="from-right"><Filmarea /></div>

  <div class="zoom-in"><Anfrage /></div>

  <style>
    :global(body) {
      overflow-x: hidden;
    }

    .hero {
      position: relative;
      display: flex;
      justify-content: center;
      align-items: center;
      width: 100%;
      max-height: 100vh;
      overflow: hidden;
    }

    .heroimg {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .gradient {
      position: absolute;
      bottom: 0;
      width: 100%;
      height: 30%;
      background: linear-gradient(
        to top,
        var(--bg) 0%,
        rgba(255, 255, 255, 0) 100%
      );
    }

    /* Mobile (3:4) */
    @media (max-width: 768px) {
      .hero {
        aspect-ratio: 3 / 5;
      }

      .heroimg {
        object-position: 44% center;
      }
    }

    /* Laptops (16:9) */
    @media (min-width: 769px) {
      .hero {
        height: 100vh;
        width: auto;
      }
    }

    h1 {
      font-family: var(--gothic-wide);
      font-weight: 900;
      font-size: 7vw;
      color: white;
      text-shadow: 0px 6px 13px rgba(0, 0, 0, 0.7);

      text-align: center;
      line-height: 0.85;
      position: absolute;
      top: 11%;
    }

    .tothe {
      font-size: 12vw;
    }

    .moon {
      color: #5acfef;
    }

    @media (min-width: 1000px) {
      h1 {
        font-size: 4vw;
      }

      .tothe {
        font-size: 7vw;
      }
    }

    .headline {
      margin-block-start: 50px;
    }

    /* ── Animations ── */

    .fade-in {
      opacity: 0;
      transform: translateY(50px);
      transition:
        opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1),
        transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .fade-in.visible {
      opacity: 1;
      transform: translateY(0);
    }

    .from-bottom {
      opacity: 0;
      transform: translateY(50px);
      transition:
        opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1),
        transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .from-left {
      opacity: 0;
      transform: translateX(-60px);
      transition:
        opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1),
        transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .from-right {
      opacity: 0;
      transform: translateX(60px);
      transition:
        opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1),
        transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .zoom-in {
      opacity: 0;
      transform: scale(0.92);
      transition:
        opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1),
        transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .from-bottom.visible,
    .from-left.visible,
    .from-right.visible,
    .zoom-in.visible {
      opacity: 1;
      transform: translate(0) scale(1);
    }

    .delay-2 {
      transition-delay: 0.15s;
    }
    .delay-3 {
      transition-delay: 0.3s;
    }

    /* ── Rest ── */

    h2 {
      color: white;
      font-weight: var(--weight-bold);
      font-family: var(--gothic-wide);
      font-size: 8.5vw;
      line-height: 0.65;

      margin-block-start: 15%;

      text-align: center;
    }

    .h2-span {
      color: var(--primary);
      font-family: var(--spills);
      font-weight: var(--weight-normal);
      font-size: 9vw;
    }

    .greet {
      color: var(--primary);
      font-family: var(--gothic-wide);
      font-weight: var(--weight-extrabold);
      font-size: 13vw;

      text-align: center;
      margin: auto;
    }

    .greet-sub {
      color: var(--text);
      font-family: var(--gothic-wide);
      font-weight: var(--weight-semibold);
      font-size: 1.3rem;
      line-height: 1.5;
      max-width: 40ch;

      text-align: center;
      margin-inline: auto;
      margin-block-start: 0.5rem;
      padding-inline: 4vw;
    }

    @media (min-width: 701px) {
      h2 {
        font-size: 8vw;
        margin-block-start: 10%;
      }

      .h2-span {
        font-size: 7.5vw;
      }
    }

    @media (min-width: 1200px) {
      h2 {
        font-size: 3.5vw;
        margin-block-start: 5%;
      }
      .h2-span {
        font-size: 4vw;
      }
    }

    @media (min-width: 1000px) {
      .greet {
        font-size: 96px;
      }

      .greet-sub {
        font-size: 1.8rem;
      }
    }

    .Spills-Text {
      font-family: var(--spills);
      font-size: 2.6rem;
      font-weight: var(--weight-normal);
    }

    .prim {
      color: var(--primary);
    }

    .btn {
      text-decoration: none;
    }

    button {
      background: linear-gradient(
        to right,
        var(--primary),
        var(--secondary),
        var(--primary)
      );
      border: none;
      border-radius: 50px;
      color: white;

      font-family: var(--gothic-wide);
      font-weight: 800;
      display: block;
      margin-inline: auto;

      transform: scale(1);
      transition: transform 150ms ease-in-out;
      cursor: pointer;
    }

    @media (max-width: 700px) {
      button {
        font-size: 4vw;
        padding: 20px 40px;
        margin-top: 2rem;
      }
    }

    @media (min-width: 701px) {
      button {
        font-size: 3vw;
        padding: 25px 35px;
        margin-top: 6rem;
      }
    }

    @media (min-width: 1000px) {
      button {
        font-size: 1.6vw;
        padding: 30px 45px;
      }
    }

    button:hover {
      transform: scale(1.05);
      transition: all 150ms ease-in-out;
    }

    button:active {
      transform: scale(0.97);
    }
  </style>

  <script>
    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
            obs.unobserve(entry.target); // Beobachtung beenden, damit Animation nur einmal läuft
          }
        });
      },
      {
        threshold: 0.1,
      },
    );

    document
      .querySelectorAll(
        ".fade-in, .from-bottom, .from-left, .from-right, .zoom-in",
      )
      .forEach((el) => observer.observe(el));
  </script>
</Layout>
