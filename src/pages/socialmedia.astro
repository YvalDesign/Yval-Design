    /* ── Animations ── */

    .fade-in {
      opacity: 0;
      transform: translateY(50px);
      transition:
        opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1),
        transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .fade-in.visible {
      opacity: 1;
      transform: translateY(0);
    }

    .from-bottom {
      opacity: 0;
      transform: translateY(50px);
      transition:
        opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1),
        transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .from-left {
      opacity: 0;
      transform: translateX(-60px);
      transition:
        opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1),
        transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .from-right {
      opacity: 0;
      transform: translateX(60px);
      transition:
        opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1),
        transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .zoom-in {
      opacity: 0;
      transform: scale(0.92);
      transition:
        opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1),
        transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .from-bottom.visible,
    .from-left.visible,
    .from-right.visible,
    .zoom-in.visible {
      opacity: 1;
      transform: translate(0) scale(1);
    }

    .delay-2 {
      transition-delay: 0.15s;
    }
    .delay-3 {
      transition-delay: 0.3s;
    }
  </style>

  <script>
    // ── IntersectionObserver für Animationen ──
    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 },
    );

    document
      .querySelectorAll(
        ".fade-in, .from-bottom, .from-left, .from-right, .zoom-in",
      )
      .forEach((el) => observer.observe(el));

    // ── Autoplay Videos ──
    const videos = document.querySelectorAll("video");

    const videoObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const video = entry.target;
          if (entry.isIntersecting) {
            const playPromise = video.play();
            if (playPromise !== undefined) {
              playPromise.catch((error) => {
                console.log("Autoplay blockiert:", error);
              });
            }
          } else {
            video.pause();
          }
        });
      },
      { root: null, threshold: 0.5 },
    );

    videos.forEach((video) => videoObserver.observe(video));

    // ── Horizontal-Scroll-Logik ──
    const hscrollContainers = Array.from(document.querySelectorAll(".ex"));

    window.addEventListener(
      "wheel",
      function (e) {
        if (hscrollContainers.length === 0) return;

        const viewportHeight = window.innerHeight;
        const viewportCenter = viewportHeight / 2;

        let activeContainer = null;
        let minDistance = Infinity;

        for (const el of hscrollContainers) {
          const rect = el.getBoundingClientRect();
          if (rect.bottom <= 0 || rect.top >= viewportHeight) continue;

          const elementCenter = rect.top + rect.height / 2;
          const distanceToCenter = Math.abs(viewportCenter - elementCenter);

          if (distanceToCenter < minDistance) {
            minDistance = distanceToCenter;
            activeContainer = el;
          }
        }

        const CENTER_THRESHOLD = 140;
        if (!activeContainer || minDistance > CENTER_THRESHOLD) return;

        const container = activeContainer;
        const maxScroll = container.scrollWidth - container.clientWidth;
        if (maxScroll <= 0) return;

        const currentScroll = container.scrollLeft;
        const EPS = 1;
        const atStart = currentScroll <= EPS;
        const atEnd = currentScroll >= maxScroll - EPS;
        const scrollingDown = e.deltaY > 0;
        const scrollingUp = e.deltaY < 0;

        if ((atEnd && scrollingDown) || (atStart && scrollingUp)) return;

        if (container.__isAnimating) {
          e.preventDefault();
          return;
        }

        e.preventDefault();

        const direction = scrollingDown ? 1 : -1;
        const firstItem = container.firstElementChild;
        let itemWidth;

        if (firstItem) {
          const itemRect = firstItem.getBoundingClientRect();
          itemWidth = itemRect.width;
        } else {
          itemWidth = container.clientWidth * 0.8;
        }

        const GAP_ESTIMATE = 16;
        const STEP = itemWidth + GAP_ESTIMATE;

        let target = currentScroll + direction * STEP;
        target = Math.max(0, Math.min(maxScroll, target));

        container.__isAnimating = true;
        container.scrollTo({ left: target, behavior: "smooth" });

        const ANIMATION_DURATION = 400;
        setTimeout(() => {
          container.__isAnimating = false;
        }, ANIMATION_DURATION);
      },
      { passive: false },
    );
  </script>
</Layout>
