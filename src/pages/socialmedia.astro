---
import Layout from "../layouts/main.astro";
import { Image } from "astro:assets";
import social from "../assets/social.png";
import DBP from "../assets/dpb.jpg";
import Mivida from "../assets/mivida.jpg";
import Neo from "../assets/neo.jpg";
import Editmiv from "../assets/edit-miv.mp4";
import Editvolk from "../assets/edit-volk.mp4";
import Mcs from "../assets/Mcs.mp4";
import Switch from "../assets/Switch.mp4";
import web3 from "../assets/dna.png";
import web4 from "../assets/crowd.png";
import web5 from "../assets/gear.png";
import web6 from "../assets/earth.png";
import neuekunden from "../assets/neuekunden.png";
import organischercontent from "../assets/organischercontent.png";
import spartzeit from "../assets/spartzeit.png";
import Workflow from "../components/sm-workflow.astro";
import Anfrage from "../components/Anfrage.astro";
---

<Layout
  title="Social Media Marketing Hildesheim | yval design"
  description="Marketing zugeschnitten auf die Zielgruppen auf den sozialen Medien. Yval Design produziert Content und verwaltet diesen auf allen Kanälen um Nähe zu deiner Kundschaft aufzubauen."
  canonicalPath="/socialmedia"
>
  <div class="webhero">
    <h1 class="webheadline">
      LETS GO! <br />
      <span class="h1-span"> Machen wir geilen Content für dich!</span>
    </h1>

    <Image
      src={social}
      alt="Social Media Grafik"
      class="heroimg"
      loading="eager"
      fetchpriority="high"
      quality={80}
      decoding="async"
      format="avif"
      width={1600}
    />
  </div>

  <div class="section-deinewebseite fade-in">
    <h2>
      Warum es <span class="h2-span-1">bei dir</span>, <br />
      <span class="h2-span-2">nicht </span> klappt
    </h2>

    <p class="webtext">
      "Ich will das Logo ganz groß im Post haben, am besten direkt oben drauf!
      Und irgendwo muss noch ein QR-Code hin! Wir wollen doch einfach nur unsere
      Produkte verkaufen!"
    </p>
    <p class="webtext from-bottom">
      Sowas hören wir ziemlich oft. Aber genau so funktioniert Social Media eben
      nicht. Die Nutzer scrollen nicht durch Instagram oder TikTok, um Werbung
      zu sehen, sondern wollen unterhalten werden, etwas lernen oder einfach nur
      abschalten. <br /> Wenn du ihnen stattdessen nur dein Produkt zeigst, swipen
      sie direkt weiter.
    </p>
    <p class="zwischen from-bottom delay-2">Deswegen</p>
    <p class="webtext from-bottom delay-3">
      Erst wenn du echten Mehrwert lieferst, sei es durch Humor, Inspiration
      oder interessante Infos, entsteht Aufmerksamkeit. Dann folgen dir die
      Leute automatisch. Und weil sie dich kennen und deinen Content positiv mit
      dir verknüpfen, ist der Schritt zum Kunden nicht mehr weit!
    </p>
    <p class="webtext from-bottom">
      Social Media kostet Zeit, Nerven und läuft oft ins Leere. Genau deshalb
      übernehmen wir das für euch, von Content bis Kampagne, komplett aus einer
      Hand.
    </p>
  </div>

  <div class="websites from-bottom">
    <h3>UNSERE VIDEOS</h3>
    <div class="ex">
      <div class="video-wrapper">
        <video
          controls
          muted
          preload="metadata"
          playsinline
          class="videoex"
          src={Editvolk}
        >
          Dein Browser unterstützt dieses Videoformat nicht.
        </video>
      </div>

      <div class="video-wrapper">
        <video
          controls
          muted
          preload="metadata"
          playsinline
          class="videoex"
          src={Editmiv}
        >
          Dein Browser unterstützt dieses Videoformat nicht.
        </video>
      </div>

      <div class="video-wrapper">
        <video
          controls
          muted
          preload="metadata"
          playsinline
          class="videoex"
          src={Mcs}
        >
          Dein Browser unterstützt dieses Videoformat nicht.
        </video>
      </div>

      <div class="video-wrapper">
        <video
          controls
          muted
          preload="auto"
          playsinline
          class="videoex"
          src={Switch}
        >
          Dein Browser unterstützt dieses Videoformat nicht.
        </video>
      </div>

      <div class="spacer"></div>
    </div>
    <h3>UNSERE FEEDS</h3>
    <div class="imgex">
      <Image
        src={DBP}
        alt="Screenshot der DBP-Website"
        class="marseille"
        loading="lazy"
        quality={80}
        decoding="async"
        format="avif"
        width={1200}
      />
      <Image
        src={Mivida}
        alt="Screenshot der Mivida-Website"
        class="marseille"
        loading="lazy"
        quality={80}
        decoding="async"
        format="avif"
        width={1200}
      />
      <Image
        src={Neo}
        alt="Screenshot der Neo-Website"
        class="marseille"
        loading="lazy"
        quality={80}
        decoding="async"
        format="avif"
        width={1200}
      />
    </div>
  </div>

  <button class="from-bottom">LASS UNS HELFEN!</button>

  <div class="benefits">
    <h3 class="from-bottom">DEINE BENEFITS</h3>

    <grid class="grid-benefits">
      <section class="benefit-card from-left">
        <Image
          src={neuekunden}
          alt="Grafik zu neuen Kunden"
          class="card-bg"
          loading="lazy"
          quality={80}
          decoding="async"
          format="avif"
          width={1200}
        />

        <div class="card-content">
          <div class="card-icon">
            <svg
              width="190"
              height="209"
              viewBox="0 0 190 209"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M97.8161 0.555386C88.0572 1.5252 79.4387 3.35775 71.0121 6.25412C56.8271 11.1298 46.3301 17.3238 37.0197 26.3121C25.8847 37.0622 19.2987 49.2623 16.7233 63.9113C15.7496 69.4515 15.4967 78.9514 16.1687 84.7544C17.3038 94.5543 16.7229 100.056 13.9671 105.597C11.7524 110.051 9.50341 112.768 4.19058 117.406C0.824461 120.345 -0.0145156 122.197 0.000188907 126.657C0.0128512 130.394 1.25293 133.293 3.95367 135.899C5.72843 137.612 10.3493 139.886 14.184 140.934L16.1241 141.464L16.1376 144.578C16.1458 146.52 16.4366 148.521 16.9104 149.893C17.6105 151.923 17.6203 152.209 17.0358 153.572C16.687 154.384 16.3851 156.244 16.3647 157.705C16.3039 162.14 17.9565 164.787 23.4764 169.095C24.4363 169.844 24.511 170.183 24.721 174.731C24.9285 179.222 25.0429 179.754 26.3103 182.125C28.0079 185.302 30.5546 187.69 33.8268 189.173C37.6806 190.92 40.6791 191.222 47.3713 190.537C59.9796 189.246 68.215 191.323 73.6843 197.174C75.7335 199.365 78.6185 204.226 78.6185 205.486C78.6185 206.246 81.1444 207.949 82.6128 208.18C83.4489 208.311 84.7842 208.611 85.5803 208.847C88.196 209.621 109.71 207.434 142.747 203.036C155.181 201.381 161.872 200.319 162.965 199.828C166.992 198.018 167.731 195.229 165.47 190.373C163.225 185.548 162.331 181.835 162.064 176.215C161.805 170.76 162.203 167.244 163.791 160.975C165.7 153.44 167.569 148.998 176.959 129.681C184.78 113.59 185.812 111.2 187.797 104.576C188.932 100.788 189.306 98.6072 189.719 93.3425C193.059 50.8186 166.289 12.2532 126.467 2.2212C117.519 -0.0331235 108.822 -0.53867 97.8161 0.555386ZM122.087 11.9872C143.979 17.0006 161.646 31.2503 171.771 52.0594C177.494 63.8218 179.845 74.9814 179.391 88.2282C178.958 100.847 176.996 106.811 165.002 131.958C155.644 151.578 152.901 159.541 151.721 170.507C151.14 175.914 151.685 182.601 153.108 187.518L154.065 190.823L153.205 191.01C151.921 191.289 121.994 195.129 113.542 196.099C107.782 196.76 88.9545 198.548 87.5266 198.57C87.3709 198.572 86.6635 197.484 85.9536 196.151C81.9482 188.632 74.636