                fill="#EB9125"></path>
            </svg>
          </div>

          <h4 class="card-headline">Organischer Content</h4>

          <p class="card-sub">
            Wir analysieren laufend die Social Media Trends! Daraus entwickeln
            wir packende Kurzvideos mit Viralpotenzial – inklusive Skript,
            Produktion und passendem Look für deinen Brand. Dazu gestalten wir
            starke 2D-Grafiken, die deine CI widerspiegeln und Vertrauen
            aufbauen.
          </p>
        </div>
      </section>

      <section class="benefit-card zoom-in">
        <Image
          src={spartzeit}
          alt="Offener Laptop mit einer offenen Website und einer Raketengrafik im Hintergrund"
          class="card-bg"
          loading="lazy"
          quality="{80}"
          decoding="async"
          aria-placeholder="blur"
          format="avif"
          widths={[800, 1600, 3000]}
        />

        <div class="card-content">
          <div class="card-icon">
            <svg
              width="209"
              height="209"
              viewBox="0 0 209 209"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M95.1263 0.247306C74.9307 2.22458 56.2651 9.66472 39.8995 22.2607C31.9298 28.3945 21.58 39.922 15.599 49.3255C13.0159 53.3868 7.98767 63.678 6.1864 68.5893C4.17241 74.0812 2.02586 82.4735 0.969566 88.9855C-0.323189 96.956 -0.323189 112.089 0.969566 120.059C2.79742 131.327 5.68894 140.436 10.6382 150.52C16.0457 161.537 21.6684 169.346 30.6722 178.345C39.6765 187.344 47.4903 192.963 58.5135 198.368C68.6036 203.314 77.7175 206.204 88.9914 208.031C96.9664 209.323 112.108 209.323 120.083 208.031C131.357 206.204 140.471 203.314 150.561 198.368C161.584 192.963 169.398 187.344 178.402 178.345C187.406 169.346 193.029 161.537 198.436 150.52C202.028 143.202 203.834 138.406 205.769 131.052C208.346 121.258 209 115.889 209 104.522C209 93.156 208.346 87.7872 205.769 77.9932C203.834 70.6389 202.028 65.8429 198.436 58.525C193.029 47.5081 187.406 39.6988 178.402 30.6996C169.398 21.7009 161.584 16.0815 150.561 10.6771C140.481 5.73511 131.186 2.78677 120.288 1.07322C114.274 0.127917 100.847 -0.312841 95.1263 0.247306ZM114.269 16.6449C134.218 18.8409 152.479 27.6798 166.952 42.1438C183.932 59.1142 192.903 80.6778 192.903 104.522C192.903 128.367 183.932 149.931 166.952 166.901C149.971 183.872 128.396 192.838 104.537 192.838C80.6789 192.838 59.103 183.872 42.1229 166.901C25.1429 149.931 16.1717 128.367 16.1717 104.522C16.1717 80.6778 25.1429 59.1142 42.1229 42.1438C56.3968 27.8781 74.8489 18.8679 94.3097 16.6612C98.8123 16.151 109.701 16.142 114.269 16.6449ZM101.012 49.29C99.0475 50.1817 97.4471 52.1283 96.7815 54.4364C96.442 55.6147 96.345 63.2139 96.435 81.626C96.5565 106.516 96.5819 107.223 97.4042 108.816C98.0882 110.141 101.35 112.802 114.586 122.837C123.572 129.649 131.745 135.715 132.749 136.317C139.589 140.416 147.675 133.121 144.213 125.973C143.384 124.262 141.739 122.905 128.005 112.609L112.719 101.15V78.3652C112.719 62.4191 112.579 55.1633 112.254 54.1906C111.093 50.728 108.094 48.5258 104.537 48.5258C103.525 48.5258 101.939 48.8697 101.012 49.29Z"
                fill="#EB9125"></path>
            </svg>
          </div>

          <h4 class="card-headline">Spart Zeit</h4>

          <p class="card-sub">
            Content planen, drehen, posten, auswerten?<br />Übernehmen wir. So
            musst du keine interne Abteilung aufbauen oder selbst alles managen
            – und kannst dich voll auf dein Business konzentrieren. Einfach
            auslagern, professionell umsetzen, besser performen.
          </p>
        </div>
      </section>
    </grid>
  </div>

  <div class="from-bottom"><Workflow /></div>

  <div class="zoom-in"><Anfrage /></div>

  <style>
    :global(body) {
      overflow-x: hidden;
    }

    h1 {
      color: var(--primary);
      font-size: 12vw;
      font-weight: var(--weight-bold);
      font-family: var(--gothic-wide);

      text-align: center;
      line-height: 0.5;
    }

    .h1-span {
      color: white;
      font-size: 7vw;
      font-family: var(--spills);
      font-weight: var(--weight-normal);
    }

    .heroimg {
      display: block;
      width: 150%;
      height: auto;
      margin-top: 0px;
      max-width: 1200px;
    }

    .webhero {
      margin-top: 10%;
      position: relative;

      display: flex;
      flex-direction: column;
      align-items: center;
      overflow-x: hidden;
    }

    @media (min-width: 1026px) {
      h1 {
        font-size: 9vw;
        line-height: 0.4;
      }

      .h1-span {
        font-size: 5.5vw;
      }
      .webhero {
        margin-top: 0;
      }
      .heroimg {
        margin-block-start: -2%;
        width: 110%;
      }

      @media (min-width: 1400px) {
        h1 {
          font-size: 7vw;
          line-height: 0.4;
        }

        .h1-span {
          font-size: 5vw;
        }
        .heroimg {
          width: 100%;
          margin-block-start: -3%;
        }
      }
    }

    @media (min-width: 1700px) {
      .heroimg {
        width: 100%;
        margin-block-start: 2%;
      }
    }

    .webheadline {
      position: absolute;
    }

    h2 {
      color: white;
      font-size: 8vw;
      font-weight: var(--weight-bold);
      font-family: var(--gothic-wide);
      line-height: 1;

      margin-block-start: -0.5em;
      margin-block-end: 1.5em;
      text-align: center;
    }

    .h2-span-1 {
      color: var(--primary);
    }

    .h2-span-2 {
      position: relative;
      top: 0.12em;
      margin-right: 1%;

      font-size: 9vw;
      font-family: var(--spills);
      font-weight: var(--weight-normal);
      color: var(--primary);
    }

    .zwischen {
      font-size: 11vw;
      font-family: var(--spills);
      font-weight: var(--weight-normal);
      color: var(--primary);
      text-align: center;
      margin-block: 1rem;
    }

    @media (min-width: 1026px) {
      h2 {
        font-size: 5.5vw;
        line-height: 0.8;
      }
      .zwischen {
        font-size: 7vw;
      }

      .h2-span-2 {
        font-size: 6.6vw;
      }
    }
    @media (min-width: 1400px) {
      h2 {
        font-size: 4.5vw;
      }
      .zwischen {
        font-size: 6vw;
      }

      .h2-span-2 {
        font-size: 5.4vw;
      }
    }

    .webtext {
      position: static;
      inset-block-end: 0;
      font-size: 18px;
      font-family: var(--gothic-wide);
      font-weight: var(--weight-semibold);
      line-height: 160%;
      color: white;

      text-align: center;
      margin-inline: auto;

      max-width: 50ch;
    }

    @media (min-width: 701px) {
      .webtext {
        font-size: 24px;
      }
    }
    @media (min-width: 1026px) {
      .webtext {
        font-size: 28px;
      }
    }

    .websites {
      width: 100%;
      margin-block-start: 80px;
      margin-inline: auto;
      display: flex;
      flex-direction: column;
