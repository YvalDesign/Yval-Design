                fill="#EB9125"></path>
            </svg>
          </div>

          <h4 class="card-headline">Neue Kunden gewinnen</h4>

          <p class="card-sub">
            Einfach nur posten bringt nichts! Wer heute online wachsen will,
            braucht Strategie, kreativen Content – und ein echtes Gespür für die
            Zielgruppe. Wir entwickeln Kampagnen und Ad-Strategien, die nicht
            nur Likes bringen, sondern echte Ergebnisse: mehr Reichweite, mehr
            Anfragen, mehr Umsatz.
          </p>
        </div>
      </section>

      <section class="benefit-card from-right">
        <Image
          src={organischercontent}
          alt="Viele Menschen, die die Hände heben"
          class="card-bg"
          loading="lazy"
          quality="{80}"
          decoding="async"
          aria-placeholder="blur"
          format="avif"
          widths={[800, 1600, 3000]}
        />

        <div class="card-content">
          <div class="card-icon">
            <svg
              width="209"
              height="180"
              viewBox="0 0 209 180"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M107.952 0.283445C111.911 0.903307 115.921 2.30211 120.416 4.63004C125.466 7.2459 132.005 13.4601 134.757 18.2581C143.489 33.4836 141.474 51.5107 129.657 63.8769L127.18 66.4696H138.376C144.535 66.4696 149.573 66.3701 149.573 66.2484C149.573 66.127 148.87 65.0504 148.01 63.8569C144.487 58.9615 142.735 53.385 142.758 47.1406C142.785 39.608 145.689 32.5896 150.923 27.4072C159.947 18.4705 172.599 16.463 184.21 22.1248C188.054 23.9995 194.197 29.9915 196.192 33.8133C201.411 43.8102 200.264 56.5034 193.38 64.9398C192.24 66.3363 191.666 67.3583 192.019 67.3583C192.357 67.3583 194.047 68.0648 195.777 68.9286C201.505 71.7889 205.551 76.387 207.844 82.6429L209 85.7987V122.902C209 157.657 208.948 160.173 208.181 162.671C205.672 170.845 199.829 176.678 191.639 179.183C189.105 179.958 185.998 180 130.654 180H72.3398L69.205 179.016C61.39 176.561 55.2755 170.115 53.1935 162.136C52.8289 160.738 52.5307 157.838 52.5307 155.69C52.5307 153.541 52.3602 151.784 52.1519 151.784C51.944 151.784 46.6855 155.416 40.4668 159.854C34.2485 164.292 28.1206 168.401 26.8501 168.983C15.6413 174.124 2.46141 166.958 0.437775 154.622C-0.176987 150.877 -0.130249 94.9064 0.489838 91.5458C2.65503 79.8151 14.808 72.9047 25.8913 77.1019C27.4524 77.6929 32.9478 81.2721 40.3586 86.5247L52.3081 94.994L52.5819 89.7298C52.8948 83.7138 53.7379 80.9793 56.5984 76.7034C60.6244 70.6852 68.1825 66.4696 74.9461 66.4696H77.1429L74.9394 64.1368C59.6504 47.9497 61.0944 22.858 78.1378 8.5696C81.8601 5.44896 87.9417 2.36476 92.8165 1.12548C96.9373 0.0777128 104.095 -0.320421 107.952 0.283445ZM93.4843 10.8575C85.0438 13.5818 77.8801 20.7345 75.1687 29.1446C73.8671 33.1824 73.5537 40.4243 74.5147 44.2577C75.5154 48.2488 78.3515 53.7996 80.8145 56.5887C88.2569 65.0162 100.611 68.3954 111.13 64.8807C119.344 62.1364 126.536 54.9575 129.285 46.7589C132.806 36.2586 129.421 23.9266 120.978 16.4976C118.36 14.1941 112.782 11.2761 109.064 10.2652C105.544 9.30811 97.3165 9.62093 93.4843 10.8575ZM168.126 28.6847C164.