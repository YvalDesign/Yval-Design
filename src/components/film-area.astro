---
import { Image } from "astro:assets";
import cam from "../assets/kamera.png";
import Mivim from "../assets/Imagefilm.mp4";
import mivmini from "../assets/imagemini.mp4";
import Eule from "../assets/Eule.mp4";
import sony from "../assets/sony.mov";
import moon from "../assets/moonani.mp4";
---

<section class="web">
  <div class="webhero">
    <h2 class="webheadline">
      KEINER CHECKTS? <br />
      <span class="h2-span"> Wir erklären es für dich!</span>
    </h2>

    <Image
      src={cam}
      alt="Eine schwebende Filmkamera umgeben von Videoediting Logos"
      class="hero"
      loading="lazy"
      quality={80}
      decoding="async"
      format="avif"
      width={1200}
    />

    <p class="webtext">
      Frustriert, weil niemand wirklich sieht, wie gut dein Produkt ist - oder
      wie stark die Zusammenarbeit mit dir eigentlich wäre? Und du bekommst es
      einfach nicht in Worte gefasst?
    </p>
  </div>
  <a href="/movies" class="btn">
    <button>LASS ES UNS IHNEN ZEIGEN!</button>
  </a>
  <div class="websites">
    <h3>UNSERE IMAGEFILME</h3>
    <div class="ex">
      <video
        controls
        muted
        preload="auto"
        playsinline
        class="videoex"
        src={Mivim}
      >
        Dein Browser unterstützt dieses Videoformat nicht.
      </video>
      <video
        controls
        muted
        preload="auto"
        playsinline
        class="videoex"
        src={mivmini}
      >
        Dein Browser unterstützt dieses Videoformat nicht.
      </video>
    </div>
  </div>
  <h3>UNSERE ANIMATIONEN</h3>
  <div class="ex">
    <video controls muted preload="auto" playsinline class="videoex" src={moon}>
      Dein Browser unterstützt dieses Videoformat nicht.
    </video>
    <video controls muted preload="auto" playsinline class="videoex" src={Eule}>
      Dein Browser unterstützt dieses Videoformat nicht.
    </video>

    <video controls muted preload="auto" playsinline class="videoex" src={sony}>
      Dein Browser unterstützt dieses Videoformat nicht.
    </video>

    <div class="spacer"></div>
  </div>
</section>

<style>
  h2 {
    color: var(--primary);
    font-size: 8vw;
    font-weight: var(--weight-bold);
    font-family: var(--gothic-wide);

    text-align: center;
    line-height: 0.6;
  }
  .h2-span {
    color: white;
    font-family: var(--spills);
    font-weight: var(--weight-normal);
    font-size: 8.5vw;
  }

  .web {
    margin-block-start: 80px;
    margin-block-end: 10%;
  }

  p {
    font-size: 1rem;
    line-height: 150%;
    font-family: var(--gothic-wide);
    font-weight: var(--weight-semibold);
    color: white;

    text-align: center;
    margin-inline: auto;
  }

  .hero {
    width: 160%;
    height: auto;
    margin-left: 4%;
    max-width: 800px;
    margin-top: 5%;
  }

  @media (min-width: 701px) {
    h2 {
      font-size: 7vw;
    }

    .h2-span {
      font-size: 7.5vw;
    }

    p {
      font-size: 1.75rem;
    }
    .hero {
      max-width: 1000px;
      margin-top: 5%;
    }
  }

  @media (min-width: 1200px) {
    h2 {
      font-size: 4.8vw;
    }
    .h2-span {
      font-size: 5.3vw;
    }
    p {
      font-size: 1.8rem;
    }
    .hero {
      max-width: 1000px;
      margin-top: 4%;
    }
  }

  @media (min-width: 1440px) {
    .hero {
      margin-top: 6%;
    }
  }

  .webhero {
    position: relative;
    display: flex;
    flex-direction: column; /* Headline oben, Bild unten */
    align-items: center; /* Abstand proportional zur View Width */
    overflow-x: clip;
    overflow-y: visible;
  }

  .webheadline {
    position: absolute;
  }

  .webtext {
    position: absolute;
    inset-block-end: -3rem;
    max-width: 42ch;
  }
  @media (min-width: 701px) {
    .webtext {
      inset-block-end: -7rem;
    }
  }

  @media (min-width: 1000px) {
    .webtext {
      inset-block-end: -1rem;
    }
  }
  .websites {
    width: 100%;
    margin-block-start: 80px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center; /* Bild mittig */
    justify-content: center;
  }
  .ex {
    display: flex;
    flex-direction: column;

    gap: 1.5rem;
    padding-bottom: 1rem;

    padding-inline: 3%;
  }

  .videoex {
    border-radius: 20px;
    overflow: hidden;
    width: 100%;

    object-fit: cover;
  }

  @media (min-width: 801px) {
    .ex {
      overflow-x: auto;
      flex-direction: row;

      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      scrollbar-width: none;
      box-sizing: border-box;
      overflow-y: visible;
    }

    .videoex {
      max-width: 50%;
      position: relative;
      flex: 0 0 auto;
      scroll-snap-align: center;
    }
  }

  .spacer {
    flex: 0 0 auto;
    scroll-snap-align: center;
    max-width: 65%;
    height: auto;
  }

  h3 {
    color: white;
    font-family: var(--gothic-xwide);
    font-weight: 600;
    font-size: 1.4rem;
    align-self: flex-start;
    margin-top: 2rem;
    margin-bottom: 1rem;
    padding-inline-start: 3%;
  }

  @media (min-width: 701px) {
    h3 {
      font-size: 3.5rem;
    }
  }
  @media (min-width: 1200px) {
    h3 {
      font-size: 5rem;
      margin-top: 4rem;
      margin-bottom: 2rem;
    }
  }

  .btn {
    text-decoration: none;
  }

  button {
    background: linear-gradient(
      to right,
      var(--primary),
      var(--secondary),
      var(--primary)
    );
    background-size: 200%;
    background-position: center;
    border: none;
    border-radius: 50px;
    color: white;

    font-family: var(--gothic-wide);
    font-weight: 800;
    display: block;
    margin-inline: auto;

    transform: scale(1);
    transition: transform 150ms ease-in-out;
    cursor: pointer;
  }

  @media (max-width: 700px) {
    button {
      font-size: 4vw;
      padding: 20px 40px;
      margin-top: 5rem;
    }
  }

  @media (min-width: 701px) {
    button {
      font-size: 3vw;
      padding: 25px 35px;
      margin-top: 7rem;
    }
  }

  @media (min-width: 1000px) {
    button {
      font-size: 1.6vw;
      padding: 30px 45px;
      margin-top: 4rem;
    }
  }

  button:hover {
    transform: scale(1.05);
    transition: all 150ms ease-in-out;
  }

  button:active {
    transform: scale(0.97);
  }
</style>

<script>
  // Alle Videos holen
  const videos = document.querySelectorAll("video");

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        const video = entry.target;

        // Änderung 1: Wir prüfen isIntersecting (basiert auf dem threshold unten)
        if (entry.isIntersecting) {
          const playPromise = video.play();

          // Änderung 2: Sicherheitsabfrage für Mobile (Low Power Mode)
          if (playPromise !== undefined) {
            playPromise.catch((error) => {
              console.log("Autoplay blockiert:", error);
            });
          }
        } else {
          video.pause();
        }
      });
    },
    {
      root: null,
      // Änderung 3: 0.5 statt 1.0 -> Video startet, wenn es zur HÄLFTE sichtbar ist
      threshold: 0.5,
    },
  );

  videos.forEach((video) => observer.observe(video));

  // 🔥 Poster-Overlay ausblenden, sobald das Video bereit ist
  const wrappers = document.querySelectorAll(".video-wrapper");
  wrappers.forEach((wrapper) => {
    const video = wrapper.querySelector("video");
    const posterImg = wrapper.querySelector(".video-poster");
    if (!video || !posterImg) return;

    const hidePoster = () => {
      posterImg.classList.add("is-hidden");
    };

    // Wenn genug Daten da sind, um zu starten
    video.addEventListener("loadeddata", hidePoster, { once: true });
    // Fallback: spätestens beim Play ausblenden
    video.addEventListener("play", hidePoster, { once: true });
  });

  // 🔁 Horizontal-Scroll-Logik für alle .ex-Container
  const hscrollContainers = Array.from(document.querySelectorAll(".ex"));

  window.addEventListener(
    "wheel",
    function (e) {
      if (hscrollContainers.length === 0) return;

      const viewportHeight = window.innerHeight;
      const viewportCenter = viewportHeight / 2;

      // 1. Finde den .ex-Container, der am nächsten zur Mitte des Viewports ist
      let activeContainer = null;
      let minDistance = Infinity;

      for (const el of hscrollContainers) {
        const rect = el.getBoundingClientRect();
        // nur Container berücksichtigen, die überhaupt im Viewport sind
        if (rect.bottom <= 0 || rect.top >= viewportHeight) continue;

        const elementCenter = rect.top + rect.height / 2;
        const distanceToCenter = Math.abs(viewportCenter - elementCenter);

        if (distanceToCenter < minDistance) {
          minDistance = distanceToCenter;
          activeContainer = el;
        }
      }

      const CENTER_THRESHOLD = 140; // anpassen: kleiner = strenger, größer = großzügiger
      if (!activeContainer || minDistance > CENTER_THRESHOLD) {
        return;
      }

      const container = activeContainer;
      const maxScroll = container.scrollWidth - container.clientWidth;
      if (maxScroll <= 0) return;

      const currentScroll = container.scrollLeft;

      const EPS = 1;
      const atStart = currentScroll <= EPS;
      const atEnd = currentScroll >= maxScroll - EPS;

      const scrollingDown = e.deltaY > 0;
      const scrollingUp = e.deltaY < 0;

      // Wenn wir am linken/rechten Rand sind und in die "falsche" Richtung scrollen → normal vertikal scrollen
      if ((atEnd && scrollingDown) || (atStart && scrollingUp)) {
        return;
      }

      // Während eine Animation läuft, keine neuen Schritte zulassen,
      // aber vertikales Scrollen blockieren, damit du nicht "rausfällst"
      if (container.__isAnimating) {
        e.preventDefault();
        return;
      }

      e.preventDefault();

      const direction = scrollingDown ? 1 : -1;

      // Schrittweite: Breite des ersten Kindes (Bild/Video) + geschätzter Gap
      const firstItem = container.firstElementChild;
      let itemWidth;

      if (firstItem) {
        const itemRect = firstItem.getBoundingClientRect();
        itemWidth = itemRect.width;
      } else {
        itemWidth = container.clientWidth * 0.8;
      }

      const GAP_ESTIMATE = 16; // px, kannst du an deinen gap anpassen
      const STEP = itemWidth + GAP_ESTIMATE;

      let target = currentScroll + direction * STEP;
      target = Math.max(0, Math.min(maxScroll, target));

      container.__isAnimating = true;

      container.scrollTo({
        left: target,
        behavior: "smooth",
      });

      // Cooldown: eine Geste = ein Schritt
      const ANIMATION_DURATION = 400; // ms
      setTimeout(() => {
        container.__isAnimating = false;
      }, ANIMATION_DURATION);
    },
    { passive: false },
  );
</script>
