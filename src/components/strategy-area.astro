---
export const prerender = true; // ← Diese Zeile ganz oben hinzufügen
import { Image } from "astro:assets";
import strat from "../assets/strat.png";
---

<section class="strat">
  <div class="heroimg">
    <Image
      src={strat}
      alt="Zwei junge Männer, die den Finger gen Mond zeigen"
      class="stratimg"
      loading="lazy"
      quality={80}
      decoding="async"
      format="avif"
      width={1200}
    />
    <div class="grad"></div>
  </div>

  <h2>
    <span class="h2-span">Strategie</span>
    <br />
    SPRINT
  </h2>

  <p>
    Wenn Orientierung fehlt oder sich Entscheidungen ständig im Kreis drehen,
    gehen wir einen Schritt zurück, sammeln eure internen Gedanken und bringen
    Positionierung, Zielgruppe und Kommunikation auf eine Linie.
  </p>

  <!-- <a class="btn" href="">
    <button>So läuft es ab</button>
  </a>-->
</section>

<style>
  .strat {
    margin-block-start: 80px;
  }

  .stratimg {
    width: 60%;
    height: auto;
    margin-inline: auto;
    display: block;
    max-width: 1000px;
  }

  h2 {
    color: var(--primary);
    font-weight: var(--weight-bold);
    font-family: var(--gothic-wide);

    text-align: center;
    line-height: 0.6;
    z-index: 1;
    margin-block-start: -7%;
  }

  .h2-span {
    color: white;
    font-family: var(--spills);
    font-weight: var(--weight-normal);
    position: relative;
    z-index: 2;
  }

  p {
    line-height: 150%;
    font-family: var(--gothic-wide);
    font-weight: var(--weight-semibold);
    color: white;

    text-align: center;
    margin-inline: auto;
    margin-block-start: -2%;
    max-width: 45ch;
  }

  @media (max-width: 700px) {
    h2 {
      font-size: 12vw;
    }

    .h2-span {
      font-size: 11vw;
    }

    p {
      font-size: 1rem;
    }
  }
  @media (min-width: 701px) {
    h2 {
      font-size: 8vw;
    }

    .h2-span {
      font-size: 6vw;
    }

    .stratimg {
      max-width: 700px;
      margin-top: 10%;
    }

    p {
      font-size: 1.6rem;
    }
  }

  @media (min-width: 1200px) {
    h2 {
      font-size: 5vw;
    }
    .h2-span {
      font-size: 4.5vw;
    }
    p {
      font-size: 1.7rem;
    }
    .stratimg {
      max-width: 500px;
      margin-top: 7.5%;
    }
  }

  @media (min-width: 1440px) {
    .stratimg {
      margin-top: 3rem;
      max-width: 540px;
    }
  }

  button {
    background: linear-gradient(
      to right,
      var(--primary),
      var(--secondary),
      var(--primary)
    );
    border: none;
    border-radius: 50px;
    color: white;

    font-family: var(--gothic-wide);
    font-weight: 800;
    display: block;
    margin-inline: auto;

    transform: scale(1);
    transition: transform 150ms ease-in-out;
    cursor: pointer;
  }
  .btn {
    text-decoration: none;
  }

  @media (max-width: 700px) {
    button {
      font-size: 4vw;
      padding: 20px 40px;
      margin-top: 2rem;
    }
  }

  @media (min-width: 701px) {
    button {
      font-size: 3vw;
      padding: 25px 35px;
      margin-top: 3rem;
    }
  }

  @media (min-width: 1000px) {
    button {
      font-size: 1.6vw;
      padding: 30px 45px;
    }
  }

  button:hover {
    transform: scale(1.05);
    transition: all 150ms ease-in-out;
  }

  button:active {
    transform: scale(0.97);
  }
</style>
