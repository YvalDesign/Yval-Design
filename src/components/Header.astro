---
import burgerbg from "../assets/burgerbg.png";
---

<header>
  <div class="head">
    <a class="anfrage-link" href="#Anfrage"
      ><button class="anfrage">Jetzt Anfragen</button></a
    >
    <nav class="nav">
      <!-- Burger Button -->
      <button id="burger" class="burger">
        <span></span>
        <span></span>
      </button>

      <!-- Fullscreen Menü -->
      <div id="menu" class="menu">
        <a href="/">Home</a>
        <a href="/webdesign">Website</a>
        <a href="/socialmedia">Social Media</a>
        <a href="/movies">Movies</a>
      </div>
    </nav>
  </div>

  <style>
    .head {
      display: flex;
      align-items: center;
    }
    .anfrage {
      scroll-behavior: smooth;
    }

    .anfrage {
      position: fixed;
      z-index: 51;
      top: 20px;
      left: 25px;
      border: 3px solid var(--primary);
      background: transparent;
      color: white;
      font-family: var(--gothic-wide);
      font-weight: var(--weight-bold);
      font-size: 3.25vw;
      padding: 10px 20px;
      cursor: pointer;
      border-radius: 20px;
    }

    @media (min-width: 701px) {
      .anfrage {
        font-size: 2.2vw;
        top: 25px;
      }
    }

    @media (min-width: 1201px) {
      .anfrage {
        font-size: 1.2vw;
        top: 30px;
      }
    }

    .anfrage:hover {
      background: var(--primary);
      transition: all 300ms ease-in-out;
    }
    /* Grundlayout */
    .nav {
      position: absolute;
      z-index: 50;
    }

    /* Burger Icon mit 2 Strichen */
    .burger {
      position: fixed;
      top: 25px;
      right: 25px;
      width: 40px;
      height: 24px;
      background: none;
      border: none;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      padding: 0;
      z-index: 501;
    }

    @media (min-width: 1000px) {
      .burger {
        top: 40px;
        right: 50px;
        width: 60px;
        gap: 0.5rem;
      }
    }

    .burger span {
      display: block;
      height: 5px;
      width: 100%;
      background: white;
      border-radius: 2px;
      transition:
        transform 0.2s ease,
        opacity 0.2s ease;
    }

    /* Wenn Menü offen, Burger zu Kreuz */
    .burger.open span:first-child {
      transform: rotate(45deg) translate(5px, 5px);
    }

    .burger.open span:last-child {
      transform: rotate(-45deg) translate(5px, -5px);
    }
    @media (min-width: 1000px) {
      .burger span {
        height: 7px;
      }
    }

    /* Fullscreen Menü */
    .menu {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;

      background-image: url("../assets/burgerbg.png");
      background-size: cover;
      background-position: left;
      background-repeat: no-repeat;

      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      transform: translateX(-100%);

      transition:
        transform 0s ease-in-out,
        opacity 0.2s ease-in-out;
    }

    .menu a {
      color: white;
      font-size: 4rem;
      font-family: var(--gothic-wide);
      font-weight: 800;

      text-align: center;
      margin: 1.5rem 0;
      text-decoration: none;
    }

    .menu a:hover,
    .menu a:focus {
      color: var(--primary);
      transform: scale(1.1);
      transition: color 0.15s ease-in-out;
      transition: transform 0.15s ease-in-out;
    }

    @media (min-width: 768px) {
      .menu a {
        font-size: 6rem;
      }
    }

    /* Menü sichtbar */
    .menu.open {
      transform: translateX(0);
      opacity: 1;
    }
  </style>

  <script>
    const burger = document.getElementById("burger");
    const menu = document.getElementById("menu");

    burger.addEventListener("click", () => {
      burger.classList.toggle("open"); // Dreht Burger zu X
      menu.classList.toggle("open"); // Zeigt/versteckt Menü
    });
  </script>
</header>
