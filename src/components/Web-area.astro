---
export const prerender = true; // ← Diese Zeile ganz oben hinzufügen
import { Image } from "astro:assets";
import web from "../assets/Leistungen.png";
import faktum from "../assets/faktumweb.png";
import mivida from "../assets/mivweb.png";
---

<section class="web">
  <div class="webhero">
    <h2 class="webheadline">
      WIR LÖSEN DEIN <br />
      <span class="h2-span"> Sichtbarkeitsproblem</span>
    </h2>

    <Image
      src={web}
      alt="Offener Laptop mit einer offenen Website und einer Raketengrafik im Hintergrund"
      class="heroimg"
      loading="lazy"
      quality={80}
      decoding="async"
      format="avif"
      width={1200}
    />

    <p class="webtext">
      Mehr Kundenanfragen? Mehr Umsatz? Mehr Bewerbungen? <br />
      Die meisten Websites haben kein klares Ziel, und genau das ist das Problem.
    </p>
  </div>
  <a href="/webdesign" class="btn">
    <button>LÖSEN WIR DAS PROBLEM!</button>
  </a>
  <div class="websites">
    <h3>UNSERE WEBSITES</h3>
    <div class="ex">
      <div class="wrapper">
        <Image
          src={faktum}
          alt="Screenshot der Faktum-Website"
          class="marseille"
          loading="lazy"
          quality={80}
          decoding="async"
          format="avif"
          width={1200}
        />
      </div>
      <div class="wrapper">
        <Image
          src={mivida}
          alt="Screenshot der Mivida-Website"
          class="marseille"
          loading="lazy"
          quality={80}
          decoding="async"
          format="avif"
          width={1200}
        />
      </div>
    </div>
  </div>
</section>

<style>
  h2 {
    color: var(--primary);
    font-size: 9vw;
    font-weight: var(--weight-bold);
    font-family: var(--gothic-wide);

    text-align: center;
    line-height: 0.6;
  }
  .h2-span {
    color: white;
    font-family: var(--spills);
    font-weight: var(--weight-normal);
    font-size: 10vw;
  }

  .web {
    margin-block-start: 80px;
  }

  p {
    font-size: 1rem;
    line-height: 150%;
    font-family: var(--gothic-wide);
    font-weight: var(--weight-semibold);
    color: white;

    text-align: center;
    margin-inline: auto;
  }

  .heroimg {
    width: 125%;
    height: auto;
    display: block;
    max-width: 1100px;
    margin-left: -2%;
  }

  @media (min-width: 701px) {
    h2 {
      font-size: 8vw;
    }

    .h2-span {
      font-size: 7.5vw;
    }

    p {
      font-size: 1.75rem;
    }
    .heroimg {
      max-width: 1000px;
      margin-top: 2%;
    }
  }

  @media (min-width: 1200px) {
    h2 {
      font-size: 5vw;
    }
    .h2-span {
      font-size: 5.5vw;
    }
    p {
      font-size: 1.8rem;
    }
    .heroimg {
      max-width: 1000px;
      margin-top: 3%;
    }
  }

  @media (min-width: 1440px) {
    img {
      margin-top: 3rem;
    }
  }

  .webhero {
    position: relative;
    display: flex;
    flex-direction: column; /* Headline oben, Bild unten */
    align-items: center; /* Abstand proportional zur View Width */
    overflow-x: clip;
    overflow-y: visible;
  }

  .webheadline {
    position: absolute;
  }

  .webtext {
    position: absolute;
    inset-block-end: -4rem;
    max-width: 42ch;
  }
  @media (min-width: 701px) {
    .webtext {
      inset-block-end: -5rem;
    }
  }

  @media (min-width: 1200px) {
    .webtext {
      inset-block-end: -4rem;
    }
  }

  .websites {
    width: 100%;
    margin-block-start: 80px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center; /* Bild mittig */
    justify-content: center;
  }

  .ex {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: center; /* Bild mittig */
    justify-content: center;
    padding-inline: 2%;
  }

  @media (min-width: 1001px) {
    .ex {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 1fr;
      padding-top: 0;
      padding-inline: 2%;
    }
  }

  h3 {
    color: white;
    font-family: var(--gothic-xwide);
    font-weight: 600;
    font-size: 1.7rem;
    align-self: flex-start;
    padding-inline-start: 2%;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  @media (min-width: 769px) {
    h3 {
      font-size: 3.5rem;
    }
  }

  @media (min-width: 1200px) {
    h3 {
      margin-top: 4rem;
      margin-bottom: 2rem;
      font-size: 5rem;
    }
  }

  .wrapper {
    overflow: hidden;
    border-radius: 30px;
    display: block;
    width: 100%;
    height: fit-content;
    flex: 0 0 auto;
    scroll-snap-align: center;
  }

  .marseille {
    border-radius: 30px;
    width: 100%;
    height: auto;
    padding: 0;
    margin: 0;
    aspect-ratio: 16/9;
    transform: scale(1);
    transition: transform 300ms ease-in-out;
    overflow: hidden;
    object-fit: cover;
  }

  .marseille:hover {
    transform: scale(1.05);
    transition: all 300ms ease-in-out;
  }

  button {
    background: linear-gradient(
      to right,
      var(--primary),
      var(--secondary),
      var(--primary)
    );
    border: none;
    border-radius: 50px;
    color: white;

    font-family: var(--gothic-wide);
    font-weight: 800;
    display: block;
    margin-inline: auto;

    transform: scale(1);
    transition: transform 150ms ease-in-out;
    cursor: pointer;
  }
  .btn {
    text-decoration: none;
  }

  @media (max-width: 700px) {
    button {
      font-size: 4vw;
      padding: 20px 40px;
      margin-top: 5rem;
    }
  }

  @media (min-width: 701px) {
    button {
      font-size: 3vw;
      padding: 25px 35px;
      margin-top: 6rem;
    }
  }

  @media (min-width: 1000px) {
    button {
      font-size: 1.6vw;
      padding: 30px 45px;
    }
  }

  button:hover {
    transform: scale(1.05);
    transition: all 150ms ease-in-out;
  }

  button:active {
    transform: scale(0.97);
  }
</style>

<script>
  // 🔁 Horizontal-Scroll-Logik für alle .ex-Container
  const hscrollContainers = Array.from(document.querySelectorAll(".ex"));

  window.addEventListener(
    "wheel",
    function (e) {
      if (hscrollContainers.length === 0) return;

      const viewportHeight = window.innerHeight;
      const viewportCenter = viewportHeight / 2;

      // 1. Finde den .ex-Container, der am nächsten zur Mitte des Viewports ist
      let activeContainer = null;
      let minDistance = Infinity;

      for (const el of hscrollContainers) {
        const rect = el.getBoundingClientRect();
        // nur Container berücksichtigen, die überhaupt im Viewport sind
        if (rect.bottom <= 0 || rect.top >= viewportHeight) continue;

        const elementCenter = rect.top + rect.height / 2;
        const distanceToCenter = Math.abs(viewportCenter - elementCenter);

        if (distanceToCenter < minDistance) {
          minDistance = distanceToCenter;
          activeContainer = el;
        }
      }

      const CENTER_THRESHOLD = 140; // anpassen: kleiner = strenger, größer = großzügiger
      if (!activeContainer || minDistance > CENTER_THRESHOLD) {
        return;
      }

      const container = activeContainer;
      const maxScroll = container.scrollWidth - container.clientWidth;
      if (maxScroll <= 0) return;

      const currentScroll = container.scrollLeft;

      const EPS = 1;
      const atStart = currentScroll <= EPS;
      const atEnd = currentScroll >= maxScroll - EPS;

      const scrollingDown = e.deltaY > 0;
      const scrollingUp = e.deltaY < 0;

      // Wenn wir am linken/rechten Rand sind und in die "falsche" Richtung scrollen → normal vertikal scrollen
      if ((atEnd && scrollingDown) || (atStart && scrollingUp)) {
        return;
      }

      // Während eine Animation läuft, keine neuen Schritte zulassen,
      // aber vertikales Scrollen blockieren, damit du nicht "rausfällst"
      if (container.__isAnimating) {
        e.preventDefault();
        return;
      }

      e.preventDefault();

      const direction = scrollingDown ? 1 : -1;

      // Schrittweite: Breite des ersten Kindes (Bild/Video) + geschätzter Gap
      const firstItem = container.firstElementChild;
      let itemWidth;

      if (firstItem) {
        const itemRect = firstItem.getBoundingClientRect();
        itemWidth = itemRect.width;
      } else {
        itemWidth = container.clientWidth * 0.8;
      }

      const GAP_ESTIMATE = 16; // px, kannst du an deinen gap anpassen
      const STEP = itemWidth + GAP_ESTIMATE;

      let target = currentScroll + direction * STEP;
      target = Math.max(0, Math.min(maxScroll, target));

      container.__isAnimating = true;

      container.scrollTo({
        left: target,
        behavior: "smooth",
      });

      // Cooldown: eine Geste = ein Schritt
      const ANIMATION_DURATION = 400; // ms
      setTimeout(() => {
        container.__isAnimating = false;
      }, ANIMATION_DURATION);
    },
    { passive: false },
  );
</script>
