---
import { Image } from "astro:assets";
import social from "../assets/social.png";
import DBP from "../assets/dpb.jpg";
import Mivida from "../assets/mivida.jpg";
import Neo from "../assets/neo.jpg";
import mivida from "../assets/mivida.png";
import Editmiv from "../assets/edit-miv.mp4";
import Editvolk from "../assets/edit-volk.mp4";
import Mcs from "../assets/Mcs.mp4";
import Switch from "../assets/Switch.mp4";
const editmposter = new URL("../assets/posters/edit-miv.jpg", import.meta.url)
  .href;
const editvposter = new URL("../assets/posters/edit-volk.jpg", import.meta.url)
  .href;
const Mcsposter = new URL("../assets/posters/mcs.jpg", import.meta.url).href;
const Switchposter = new URL("../assets/posters/Switch.jpg", import.meta.url)
  .href;
---

<section class="web">
  <div class="webhero">
    <h2 class="webheadline">
      KEIN BOCK AUF <br /> SOCIAL MEDIA? <br />
      <span class="h2-span"> Das übernehmen wir für dich!</span>
    </h2>

    <Image
      src={social}
      alt="Offener Laptop mit einer offenen Website und einer Raketengrafik im Hintergrund"
      class="heroimg"
      loading="lazy"
      quality="{80}"
      decoding="async"
      placeholder="blur"
      format="avif"
      widths={[800, 1600, 3000]}
    />

    <p class="webtext">
      Du hast keine Zeit, kein Wissen, keine Lust und daher keinen Erfolg auf
      Social Media? Du schaffst es nicht, die Nutzer in Kunden umzuwandeln? Das
      hat jetzt ein Ende!
    </p>
  </div>
  <a href="/socialmedia" class="btn">
    <button>LASS UNS HELFEN!</button>
  </a>
  <div class="websites">
    <h3>UNSERE FEEDS</h3>
    <div class="ex">
      <Image
        src={DBP}
        alt="Offener Laptop mit einer offenen Website und einer Raketengrafik im Hintergrund"
        class="marseille"
        loading="lazy"
        quality="{80}"
        decoding="async"
        placeholder="blur"
        format="avif"
        widths={[800, 1600, 3000]}
      />
      <Image
        src={Mivida}
        alt="Offener Laptop mit einer offenen Website und einer Raketengrafik im Hintergrund"
        class="marseille"
        loading="lazy"
        quality="{80}"
        decoding="async"
        placeholder="blur"
        format="avif"
        widths={[800, 1600, 3000]}
      />
      <Image
        src={Neo}
        alt="Offener Laptop mit einer offenen Website und einer Raketengrafik im Hintergrund"
        class="marseille"
        loading="lazy"
        quality="{80}"
        decoding="async"
        placeholder="blur"
        format="avif"
        widths={[800, 1600, 3000]}
      />
    </div>
    <h3>UNSERE VIDEOS</h3>
    <div class="ex">
      <div class="video-wrapper">
        <img src={editvposter} alt="" class="video-poster" loading="lazy" />
        <video controls muted preload="metadata" playsinline class="videoex">
          <source src={Editvolk} type="video/mp4" />
          <source src={Editvolk} type="video/webm" />
          Dein Browser unterstützt dieses Videoformat nicht.
        </video>
      </div>

      <div class="video-wrapper">
        <img src={editmposter} alt="" class="video-poster" loading="lazy" />
        <video controls muted preload="metadata" playsinline class="videoex">
          <source src={Editmiv} type="video/mp4" />
          <source src={Editmiv} type="video/webm" />
          Dein Browser unterstützt dieses Videoformat nicht.
        </video>
      </div>

      <div class="video-wrapper">
        <img src={Mcsposter} alt="" class="video-poster" loading="lazy" />
        <video controls muted preload="metadata" playsinline class="videoex">
          <source src={Mcs} type="video/mp4" />
          <source src={Mcs} type="video/webm" />
          Dein Browser unterstützt dieses Videoformat nicht.
        </video>
      </div>

      <div class="video-wrapper">
        <img src={Switchposter} alt="" class="video-poster" loading="lazy" />
        <video controls muted preload="metadata" playsinline class="videoex">
          <source src={Switch} type="video/mp4" />
          <source src={Switch} type="video/webm" />
          Dein Browser unterstützt dieses Videoformat nicht.
        </video>
      </div>

      <div class="spacer"></div>
    </div>
  </div>
</section>

<style>
  h2 {
    color: var(--primary);
    font-weight: var(--weight-bold);
    font-family: var(--gothic-wide);

    text-align: center;
    line-height: 0.9;
  }

  .h2-span {
    color: white;
    font-family: var(--spills);
    font-weight: var(--weight-normal);
  }

  .web {
    margin-block-start: 80px;
  }

  p {
    line-height: 150%;
    font-family: var(--gothic-wide);
    font-weight: var(--weight-semibold);
    color: white;

    text-align: center;
    margin-inline: auto;
  }

  .heroimg {
    width: 160%;
    height: auto;
    max-width: 1200px;
    margin-top: 7%;
  }

  @media (max-width: 700px) {
    h2 {
      font-size: 8vw;
    }

    .h2-span {
      font-size: 8.5vw;
    }

    p {
      font-size: 1rem;
    }
  }
  @media (min-width: 701px) {
    h2 {
      font-size: 7vw;
    }

    .h2-span {
      font-size: 7.5vw;
    }

    img {
      width: 150%;
    }

    p {
      font-size: 1.75rem;
    }
  }

  @media (min-width: 1200px) {
    h2 {
      font-size: 5vw;
    }
    .h2-span {
      font-size: 5.5vw;
    }
    p {
      font-size: 2rem;
    }
  }

  @media (min-width: 1440px) {
    img {
      margin-top: 2.5rem;
    }
  }

  .webhero {
    position: relative;
    display: flex;
    flex-direction: column; /* Headline oben, Bild unten */
    align-items: center;
    overflow-x: clip; /* Abstand proportional zur View Width */
    overflow-y: visible;
  }

  .webheadline {
    position: absolute;
  }

  .webtext {
    position: absolute;
    inset-block-end: -4rem;
    max-width: 42ch;
  }

  @media (min-width: 701px) {
    .webtext {
      inset-block-end: -6rem;
    }
  }

  @media (min-width: 1200px) {
    .webtext {
      inset-block-end: -3rem;
    }
  }

  .websites {
    max-width: 1200px;
    margin-block-start: 80px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center; /* Bild mittig */
    justify-content: center;
    padding-inline: 1rem;
  }

  .ex {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: 1rem;
    padding-top: 0;
    scroll-behavior: smooth;
    scrollbar-width: none;
    width: 100%;
  }

  h3 {
    color: white;
    font-family: var(--gothic-xwide);
    font-weight: 600;
    font-size: 5.5vw;
    align-self: flex-start;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  @media (min-width: 701px) {
    h3 {
      font-size: 2rem;
    }
  }
  @media (min-width: 1200px) {
    h3 {
      font-size: 3rem;
      margin-top: 4rem;
      margin-bottom: 2rem;
    }
  }

  .marseille {
    flex: 0 0 auto;
    scroll-snap-align: center;

    border-radius: 20px;
    width: 90%;
    height: auto;
  }

  .video-wrapper {
    position: relative;
    flex: 0 0 auto;
    scroll-snap-align: center;
    max-width: 65%;
    border-radius: 8px;
    overflow: hidden; /* damit Poster & Video sauber abgerundet sind */
  }

  .videoex {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Poster-Bild liegt über dem Video */
  .video-poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 200ms ease;
  }

  /* wird per JS gesetzt, sobald Video geladen ist */
  .video-poster.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  /* Falls du die 80vh-Logik behalten willst, eher hier: */
  @media (min-width: 701px) {
    .video-wrapper {
      height: 80vh;
    }
  }

  .spacer {
    flex: 0 0 auto;
    scroll-snap-align: center;
    max-width: 65%;
    height: auto;
  }

  button {
    background: linear-gradient(
      to right,
      var(--primary),
      var(--secondary),
      var(--primary)
    );
    border: none;
    border-radius: 50px;
    color: white;

    font-family: var(--gothic-wide);
    font-weight: 800;
    display: block;
    margin-inline: auto;

    transform: scale(1);
    transition: transform 150ms ease-in-out;
    cursor: pointer;
  }

  .btn {
    text-decoration: none;
  }

  @media (max-width: 700px) {
    button {
      font-size: 4vw;
      padding: 20px 40px;
      margin-top: 5rem;
    }
  }

  @media (min-width: 701px) {
    button {
      font-size: 3vw;
      padding: 25px 35px;
      margin-top: 6rem;
    }
  }

  @media (min-width: 1000px) {
    button {
      font-size: 2vw;
      padding: 30px 45px;
    }
  }

  button:hover {
    transform: scale(1.05);
    transition: all 150ms ease-in-out;
  }

  button:active {
    transform: scale(0.97);
  }
</style>

<script>
  // Alle Videos holen
  const videos = document.querySelectorAll("video");

  // IntersectionObserver: Videos nur abspielen, wenn komplett im Viewport
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        const video = entry.target;
        if (entry.intersectionRatio === 1) {
          video.play();
        } else {
          video.pause();
        }
      });
    },
    {
      root: null, // viewport
      threshold: 1.0,
    },
  );

  videos.forEach((video) => observer.observe(video));

  // 🔥 Poster-Overlay ausblenden, sobald das Video bereit ist
  const wrappers = document.querySelectorAll(".video-wrapper");
  wrappers.forEach((wrapper) => {
    const video = wrapper.querySelector("video");
    const posterImg = wrapper.querySelector(".video-poster");
    if (!video || !posterImg) return;

    const hidePoster = () => {
      posterImg.classList.add("is-hidden");
    };

    // Wenn genug Daten da sind, um zu starten
    video.addEventListener("loadeddata", hidePoster, { once: true });
    // Fallback: spätestens beim Play ausblenden
    video.addEventListener("play", hidePoster, { once: true });
  });

  // 🔁 Horizontal-Scroll-Logik für alle .ex-Container
  const hscrollContainers = Array.from(document.querySelectorAll(".ex"));

  window.addEventListener(
    "wheel",
    function (e) {
      if (hscrollContainers.length === 0) return;

      const viewportHeight = window.innerHeight;
      const viewportCenter = viewportHeight / 2;

      // 1. Finde den .ex-Container, der am nächsten zur Mitte des Viewports ist
      let activeContainer = null;
      let minDistance = Infinity;

      for (const el of hscrollContainers) {
        const rect = el.getBoundingClientRect();
        // nur Container berücksichtigen, die überhaupt im Viewport sind
        if (rect.bottom <= 0 || rect.top >= viewportHeight) continue;

        const elementCenter = rect.top + rect.height / 2;
        const distanceToCenter = Math.abs(viewportCenter - elementCenter);

        if (distanceToCenter < minDistance) {
          minDistance = distanceToCenter;
          activeContainer = el;
        }
      }

      const CENTER_THRESHOLD = 140; // anpassen: kleiner = strenger, größer = großzügiger
      if (!activeContainer || minDistance > CENTER_THRESHOLD) {
        return;
      }

      const container = activeContainer;
      const maxScroll = container.scrollWidth - container.clientWidth;
      if (maxScroll <= 0) return;

      const currentScroll = container.scrollLeft;

      const EPS = 1;
      const atStart = currentScroll <= EPS;
      const atEnd = currentScroll >= maxScroll - EPS;

      const scrollingDown = e.deltaY > 0;
      const scrollingUp = e.deltaY < 0;

      // Wenn wir am linken/rechten Rand sind und in die "falsche" Richtung scrollen → normal vertikal scrollen
      if ((atEnd && scrollingDown) || (atStart && scrollingUp)) {
        return;
      }

      // Während eine Animation läuft, keine neuen Schritte zulassen,
      // aber vertikales Scrollen blockieren, damit du nicht "rausfällst"
      if (container.__isAnimating) {
        e.preventDefault();
        return;
      }

      e.preventDefault();

      const direction = scrollingDown ? 1 : -1;

      // Schrittweite: Breite des ersten Kindes (Bild/Video) + geschätzter Gap
      const firstItem = container.firstElementChild;
      let itemWidth;

      if (firstItem) {
        const itemRect = firstItem.getBoundingClientRect();
        itemWidth = itemRect.width;
      } else {
        itemWidth = container.clientWidth * 0.8;
      }

      const GAP_ESTIMATE = 16; // px, kannst du an deinen gap anpassen
      const STEP = itemWidth + GAP_ESTIMATE;

      let target = currentScroll + direction * STEP;
      target = Math.max(0, Math.min(maxScroll, target));

      container.__isAnimating = true;

      container.scrollTo({
        left: target,
        behavior: "smooth",
      });

      // Cooldown: eine Geste = ein Schritt
      const ANIMATION_DURATION = 400; // ms
      setTimeout(() => {
        container.__isAnimating = false;
      }, ANIMATION_DURATION);
    },
    { passive: false },
  );
</script>
