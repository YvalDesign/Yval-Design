---
import { Image } from "astro:assets";
import social from "../assets/social.png";
import DBP from "../assets/dpb.jpg";
import Mivida from "../assets/mivida.jpg";
import Neo from "../assets/neo.jpg";
import mivida from "../assets/mivida.png";
import Editmiv from "../assets/edit-miv.mp4";
import Editvolk from "../assets/edit-volk.mp4";
import Mcs from "../assets/Mcs.mp4";
import Switch from "../assets/Switch.mp4";
---

<section class="web">
  <div class="webhero">
    <h2 class="webheadline">
      KEIN BOCK AUF <br /> SOCIAL MEDIA? <br />
      <span class="h2-span"> Das übernehmen wir für dich!</span>
    </h2>

    <Image
      src={social}
      alt="Offener Laptop mit einer offenen Website und einer Raketengrafik im Hintergrund"
      class="heroimg"
      loading="lazy"
      quality="{80}"
      decoding="async"
      placeholder="blur"
      format="avif"
      widths={[800, 1600, 3000]}
    />

    <p class="webtext">
      Du hast keine Zeit, kein Wissen, keine Lust und daher keinen Erfolg auf
      Social Media? Du schaffst es nicht, die Nutzer in Kunden umzuwandeln? Das
      hat jetzt ein Ende!
    </p>
  </div>
  <a href="/socialmedia" class="btn">
    <button>LASS UNS HELFEN!</button>
  </a>
  <div class="websites">
    <h3>UNSERE FEEDS</h3>
    <div class="ex">
      <Image
        src={DBP}
        alt="Offener Laptop mit einer offenen Website und einer Raketengrafik im Hintergrund"
        class="marseille"
        loading="lazy"
        quality="{80}"
        decoding="async"
        placeholder="blur"
        format="avif"
        widths={[800, 1600, 3000]}
      />
      <Image
        src={Mivida}
        alt="Offener Laptop mit einer offenen Website und einer Raketengrafik im Hintergrund"
        class="marseille"
        loading="lazy"
        quality="{80}"
        decoding="async"
        placeholder="blur"
        format="avif"
        widths={[800, 1600, 3000]}
      />
      <Image
        src={Neo}
        alt="Offener Laptop mit einer offenen Website und einer Raketengrafik im Hintergrund"
        class="marseille"
        loading="lazy"
        quality="{80}"
        decoding="async"
        placeholder="blur"
        format="avif"
        widths={[800, 1600, 3000]}
      />
    </div>
    <h3>UNSERE VIDEOS</h3>
    <div class="ex">
      <div class="video-wrapper">
        <video
          controls
          muted
          preload="auto"
          playsinline
          class="videoex"
          src={Editvolk + "#t=0.001"}
        >
          Dein Browser unterstützt dieses Videoformat nicht.
        </video>
      </div>

      <div class="video-wrapper">
        <video
          controls
          muted
          preload="auto"
          playsinline
          class="videoex"
          src={Editmiv + "#t=0.001"}
        >
          Dein Browser unterstützt dieses Videoformat nicht.
        </video>
      </div>

      <div class="video-wrapper">
        <video
          controls
          muted
          preload="auto"
          playsinline
          class="videoex"
          src={Mcs + "#t=0.001"}
        >
          Dein Browser unterstützt dieses Videoformat nicht.
        </video>
      </div>

      <div class="video-wrapper">
        <video
          controls
          muted
          preload="auto"
          playsinline
          class="videoex"
          src={Switch + "#t=0.001"}
        >
          Dein Browser unterstützt dieses Videoformat nicht.
        </video>
      </div>

      <div class="spacer"></div>
    </div>
  </div>
</section>

<style>
  h2 {
    color: var(--primary);
    font-weight: var(--weight-bold);
    font-family: var(--gothic-wide);

    text-align: center;
    line-height: 0.9;
  }

  .h2-span {
    color: white;
    font-family: var(--spills);
    font-weight: var(--weight-normal);
  }

  .web {
    margin-block-start: 80px;
  }

  p {
    line-height: 150%;
    font-family: var(--gothic-wide);
    font-weight: var(--weight-semibold);
    color: white;

    text-align: center;
    margin-inline: auto;
  }

  .heroimg {
    width: 160%;
    height: auto;
    max-width: 1100px;
    margin-top: 7%;
  }

  @media (max-width: 700px) {
    h2 {
      font-size: 8vw;
    }

    .h2-span {
      font-size: 8.5vw;
    }

    p {
      font-size: 1rem;
    }
  }
  @media (min-width: 701px) {
    h2 {
      font-size: 7vw;
    }

    .h2-span {
      font-size: 7.5vw;
    }

    .heroimg {
      max-width: 1000px;
      margin-top: 10%;
    }

    p {
      font-size: 1.75rem;
    }
  }

  @media (min-width: 1200px) {
    h2 {
      font-size: 4.3vw;
    }
    .h2-span {
      font-size: 4.5vw;
    }
    p {
      font-size: 2rem;
    }
    .heroimg {
      max-width: 1000px;
      margin-top: 7.5%;
    }
  }

  @media (min-width: 1440px) {
    img {
      margin-top: 3rem;
    }
  }

  .webhero {
    position: relative;
    display: flex;
    flex-direction: column; /* Headline oben, Bild unten */
    align-items: center;
    overflow-x: clip; /* Abstand proportional zur View Width */
    overflow-y: visible;
  }

  .webheadline {
    position: absolute;
  }

  .webtext {
    position: absolute;
    inset-block-end: -4rem;
    max-width: 42ch;
  }

  @media (min-width: 701px) {
    .webtext {
      inset-block-end: -6rem;
    }
  }

  @media (min-width: 1200px) {
    .webtext {
      inset-block-end: -3rem;
    }
  }

  .websites {
    max-width: 1200px;
    margin-block-start: 80px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center; /* Bild mittig */
    justify-content: center;
    padding-inline: 1rem;
  }

  .ex {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: 1rem;
    padding-top: 0;
    scroll-behavior: smooth;
    scrollbar-width: none;
    width: 100%;
  }

  h3 {
    color: white;
    font-family: var(--gothic-xwide);
    font-weight: 600;
    font-size: 5.5vw;
    align-self: flex-start;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  @media (min-width: 701px) {
    h3 {
      font-size: 2rem;
    }
  }
  @media (min-width: 1200px) {
    h3 {
      font-size: 3rem;
      margin-top: 4rem;
      margin-bottom: 2rem;
    }
  }

  .marseille {
    flex: 0 0 auto;
    scroll-snap-align: center;

    border-radius: 20px;
    width: 90%;
    height: auto;
  }

  .video-wrapper {
    position: relative;
    flex: 0 0 auto;
    scroll-snap-align: center;
    max-width: 65%;
    aspect-ratio: 16 9; /* Seitenverhältnis fixiert */

    /* 💥 NEUE KORREKTUR: Feste Höhe für mobile/kleine Bildschirme setzen, damit die Videos Dimensionen haben, auch wenn das Poster fehlt. */
    height: 50.5vh;

    border-radius: 8px;
    overflow: hidden;
  }
  /* Falls du die 80vh-Logik behalten willst, eher hier: */
  @media (min-width: 701px) {
    .video-wrapper {
      max-width: 80%; /* Vielleicht etwas breiter auf Desktop? */
      height: 80vh;
    }
  }

  .videoex {
    width: 100%;
    height: 100%;
    display: block;
  }

  .spacer {
    flex: 0 0 auto;
    scroll-snap-align: center;
    max-width: 65%;
    height: auto;
  }

  button {
    background: linear-gradient(
      to right,
      var(--primary),
      var(--secondary),
      var(--primary)
    );
    border: none;
    border-radius: 50px;
    color: white;

    font-family: var(--gothic-wide);
    font-weight: 800;
    display: block;
    margin-inline: auto;

    transform: scale(1);
    transition: transform 150ms ease-in-out;
    cursor: pointer;
  }

  .btn {
    text-decoration: none;
  }

  @media (max-width: 700px) {
    button {
      font-size: 4vw;
      padding: 20px 40px;
      margin-top: 5rem;
    }
  }

  @media (min-width: 701px) {
    button {
      font-size: 3vw;
      padding: 25px 35px;
      margin-top: 4.5rem;
    }
  }

  @media (min-width: 1000px) {
    button {
      font-size: 1.6vw;
      padding: 30px 45px;
    }
  }

  button:hover {
    transform: scale(1.05);
    transition: all 150ms ease-in-out;
  }

  button:active {
    transform: scale(0.97);
  }
</style>

<script>
  // Alle Videos holen
  const videos = document.querySelectorAll("video");

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        const video = entry.target;

        // WICHTIG: Wir prüfen hier auf "isIntersecting" statt auf die genaue Ratio.
        // Sobald der Threshold (unten definiert) überschritten ist, ist isIntersecting = true.
        if (entry.isIntersecting) {
          // Wir fangen Fehler ab, falls das Handy im Stromsparmodus ist (da ist Autoplay verboten)
          const playPromise = video.play();
          if (playPromise !== undefined) {
            playPromise.catch((error) => {
              console.log(
                "Autoplay blockiert (oft wegen Stromsparmodus):",
                error,
              );
            });
          }
        } else {
          video.pause();
        }
      });
    },
    {
      root: null,
      // HIER LAG DAS PROBLEM:
      // Statt 1.0 (100%) nehmen wir 0.5. Das heißt:
      // Sobald das Video zur HÄLFTE im Bild ist, fängt es an zu spielen.
      threshold: 0.5,
    },
  );

  videos.forEach((video) => observer.observe(video));

  // 🔁 Horizontal-Scroll-Logik für alle .ex-Container
  const hscrollContainers = Array.from(document.querySelectorAll(".ex"));

  window.addEventListener(
    "wheel",
    function (e) {
      if (hscrollContainers.length === 0) return;

      const viewportHeight = window.innerHeight;
      const viewportCenter = viewportHeight / 2;

      // 1. Finde den .ex-Container, der am nächsten zur Mitte des Viewports ist
      let activeContainer = null;
      let minDistance = Infinity;

      for (const el of hscrollContainers) {
        const rect = el.getBoundingClientRect();
        // nur Container berücksichtigen, die überhaupt im Viewport sind
        if (rect.bottom <= 0 || rect.top >= viewportHeight) continue;

        const elementCenter = rect.top + rect.height / 2;
        const distanceToCenter = Math.abs(viewportCenter - elementCenter);

        if (distanceToCenter < minDistance) {
          minDistance = distanceToCenter;
          activeContainer = el;
        }
      }

      const CENTER_THRESHOLD = 140; // anpassen: kleiner = strenger, größer = großzügiger
      if (!activeContainer || minDistance > CENTER_THRESHOLD) {
        return;
      }

      const container = activeContainer;
      const maxScroll = container.scrollWidth - container.clientWidth;
      if (maxScroll <= 0) return;

      const currentScroll = container.scrollLeft;

      const EPS = 1;
      const atStart = currentScroll <= EPS;
      const atEnd = currentScroll >= maxScroll - EPS;

      const scrollingDown = e.deltaY > 0;
      const scrollingUp = e.deltaY < 0;

      // Wenn wir am linken/rechten Rand sind und in die "falsche" Richtung scrollen → normal vertikal scrollen
      if ((atEnd && scrollingDown) || (atStart && scrollingUp)) {
        return;
      }

      // Während eine Animation läuft, keine neuen Schritte zulassen,
      // aber vertikales Scrollen blockieren, damit du nicht "rausfällst"
      if (container.__isAnimating) {
        e.preventDefault();
        return;
      }

      e.preventDefault();

      const direction = scrollingDown ? 1 : -1;

      // Schrittweite: Breite des ersten Kindes (Bild/Video) + geschätzter Gap
      const firstItem = container.firstElementChild;
      let itemWidth;

      if (firstItem) {
        const itemRect = firstItem.getBoundingClientRect();
        itemWidth = itemRect.width;
      } else {
        itemWidth = container.clientWidth * 0.8;
      }

      const GAP_ESTIMATE = 16; // px, kannst du an deinen gap anpassen
      const STEP = itemWidth + GAP_ESTIMATE;

      let target = currentScroll + direction * STEP;
      target = Math.max(0, Math.min(maxScroll, target));

      container.__isAnimating = true;

      container.scrollTo({
        left: target,
        behavior: "smooth",
      });

      // Cooldown: eine Geste = ein Schritt
      const ANIMATION_DURATION = 400; // ms
      setTimeout(() => {
        container.__isAnimating = false;
      }, ANIMATION_DURATION);
    },
    { passive: false },
  );
</script>
